@model SaraTourism.Models.TourGuide
@using System.Collections.Generic
@using System.Web.Mvc
@{ ViewBag.Title = "Edit tour guide";
                ViewBag.CurrentNav = "tourguides"; }
<h1>Edit tour guide</h1>
<div class="allocate-card">
    @using (Html.BeginForm("Edit", "TourGuide", FormMethod.Post))
    {
@Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.TourGuideID)
                                @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })

                                                <div class="field">
                                                    @Html.LabelFor(m => m.Name)
                                                    @Html.TextBoxFor(m => m.Name)
                                                    @Html.ValidationMessageFor(m => m.Name)
                                                </div>
                                                                <div class="field">
                                                                    @Html.LabelFor(m => m.Specialization)
                                                                    @Html.DropDownListFor(m => m.Specialization, new List<SelectListItem>
                                                                {
                new SelectListItem { Text = "Wildlife tours", Value = "Wildlife tours", Selected = Model.Specialization == "Wildlife tours" },
                new SelectListItem { Text = "Cultural heritage tours", Value = "Cultural heritage tours", Selected = Model.Specialization == "Cultural heritage tours" },
                new SelectListItem { Text = "Adventure & hiking tours", Value = "Adventure & hiking tours", Selected = Model.Specialization == "Adventure & hiking tours" },
                new SelectListItem { Text = "Scenic tours", Value = "Scenic tours", Selected = Model.Specialization == "Scenic tours" }
            })
                                                                    @Html.ValidationMessageFor(m => m.Specialization)
                                                                </div>
                                                                                <button type="submit" class="primary-btn">Save changes</button>}
    <div style="margin-top:14px;"><a href="@Url.Action("Index")" style="color:var(--muted);font-size:13px;">&larr; Back to tour guides</a></div>
</div>
